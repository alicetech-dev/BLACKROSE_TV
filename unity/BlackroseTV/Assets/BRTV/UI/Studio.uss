/* BlackRose TV Studio — estilo «juego»: tarjetas oscuras, rosa/cian de la marca. Editable en el UI Builder. */
:root {
    --fondo: rgb(12, 9, 24);
    --panel: rgba(23, 18, 48, 0.92);
    --panel2: rgb(32, 26, 64);
    --borde: rgb(52, 41, 95);
    --texto: rgb(239, 234, 255);
    --suave: rgb(168, 155, 214);
    --rosa: rgb(255, 47, 214);
    --cian: rgb(0, 229, 255);
    --ok: rgb(125, 255, 196);
    --mal: rgb(255, 95, 122);
    color: var(--texto);
    font-size: 15px;
}
.app { flex-grow: 1; }
.cabecera {
    flex-direction: row; align-items: center; padding: 8px 16px;
    background-color: rgba(26, 15, 51, 0.95); border-bottom-width: 1px; border-color: var(--borde);
}
.logo { font-size: 20px; -unity-font-style: bold; color: var(--rosa); margin-right: 18px; letter-spacing: 2px; }
.tabs { flex-direction: row; flex-grow: 1; }
.tab {
    background-color: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(0, 0, 0, 0);
    border-radius: 999px; padding: 6px 14px; margin-right: 6px; color: var(--suave);
}
.tab:hover { color: var(--texto); }
.tab.activo { background-color: var(--panel2); border-color: var(--rosa); color: var(--texto); }
.tab.pronto { opacity: 0.4; }
.estado { color: var(--mal); font-size: 13px; }
.estado.ok { color: var(--ok); }

.cuerpo { flex-grow: 1; }
.pantalla { flex-grow: 1; }
.set-pantalla { flex-direction: row; }
.vista { flex-grow: 1; padding: 12px; }
.chip-aire {
    align-self: flex-start; background-color: rgba(0, 0, 0, 0.7); border-width: 1px; border-color: var(--rosa);
    border-radius: 999px; padding: 2px 10px; font-size: 12px; letter-spacing: 1px; color: var(--texto);
}
.ayuda-tab { position: absolute; left: 14px; bottom: 10px; font-size: 11px; color: rgba(168, 155, 214, 0.7); }
.lateral { width: 360px; padding: 12px; }
.tarjeta {
    background-color: var(--panel); border-width: 1px; border-color: var(--borde); border-radius: 14px;
    padding: 14px; margin-bottom: 12px;
}
.h2 { font-size: 13px; letter-spacing: 1.5px; color: var(--suave); margin-bottom: 10px; -unity-font-style: bold; }
.ayuda { font-size: 12px; color: var(--suave); white-space: normal; }
.texto { white-space: normal; color: var(--texto); margin-bottom: 12px; }

.sets { flex-direction: row; flex-wrap: wrap; }
.set {
    width: 48%; margin: 0 2% 8px 0; padding: 8px 6px; border-radius: 10px; font-size: 12px; white-space: normal; min-height: 44px;
    background-color: var(--panel2); border-width: 2px; border-color: rgba(0, 0, 0, 0); color: var(--texto);
}
.set:hover { border-color: var(--borde); }
.set.activo { border-color: var(--cian); }

.camaras { flex-direction: row; flex-wrap: wrap; }
.cam {
    width: 48%; margin: 0 2% 8px 0; padding: 8px 10px; border-radius: 12px; align-items: flex-start;
    background-color: var(--panel2); border-width: 2px; border-color: var(--borde);
}
.cam #titulo { -unity-font-style: bold; color: var(--texto); font-size: 13px; }
.cam #sub { color: var(--suave); font-size: 11px; }
.cam.activo { border-color: var(--rosa); }
.cam.aire { border-color: rgb(255, 47, 79); }

.puesto { flex-direction: row; align-items: center; margin-bottom: 8px; }
.puesto #etq { width: 80px; color: var(--suave); font-size: 13px; }
.puesto DropdownField { flex-grow: 1; margin: 0; }

.hoja { align-items: center; justify-content: center; background-color: rgba(12, 9, 24, 0.85); }
.centro { width: 520px; }
.boton {
    background-color: var(--rosa); color: rgb(255, 255, 255); border-width: 0; border-radius: 999px;
    padding: 8px 18px; -unity-font-style: bold; align-self: flex-start;
}
.boton:hover { background-color: rgb(255, 90, 225); }

/* desplegables oscuros (por defecto Unity los pinta gris claro) */
.puesto .unity-base-field__input, .unity-base-popup-field__input {
    background-color: var(--panel2); border-color: var(--borde); border-radius: 8px; color: var(--texto); padding: 6px 8px;
}
.unity-base-popup-field__text { color: var(--texto); }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: var(--suave); }
.unity-base-dropdown__container-outer { background-color: var(--panel2); border-color: var(--borde); }
.unity-base-dropdown__label { color: var(--texto); }
.unity-base-dropdown__item:hover { background-color: var(--borde); }
.lateral .unity-scroller--vertical { width: 8px; }
